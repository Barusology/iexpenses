{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci --legacy-peer-deps && npm install --no-save ajv@^8.20.0 --legacy-peer-deps",
  "buildCommand": "cd frontend && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "iexpenses.vercel.app" }],
      "destination": "https://iexpenses.xyz/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "iexpenses.vercel.app" }],
      "destination": "https://iexpenses.xyz/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
